<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Viridian.Library</RootNamespace>
    <Description>Biblioteca botânica do Viridian: catálogo de espécies, configurações e arquivos do escritório.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Viridian.Core\Viridian.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\*.txt;Data\*.json" LogicalName="Viridian.Library.Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
