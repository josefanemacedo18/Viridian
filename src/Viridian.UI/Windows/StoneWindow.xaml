<ui:ViridianWindow x:Class="Viridian.UI.Windows.StoneWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Pedras e coberturas"
                   Width="1260" Height="780" MinWidth="1060" MinHeight="620">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Style="{StaticResource VirHeader}" Text="Pedras e coberturas" Margin="0" />
            <TextBlock Style="{StaticResource VirHint}" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="Seixos, pedriscos, britas, cascalhos, pedras trituradas, pó de pedra, saibro, argila expandida e coberturas orgânicas. Escolha o uso (cobertura de canteiro, borda de caminho, piso solto ou compactado, camada drenante, cobertura morta) e leve para o Revit. Densidade, vazios e perdas são valores de referência: confirme com o fornecedor." />
        </StackPanel>

        <!-- Biblioteca -->
        <Grid Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="Pesquisar pedra ou cobertura" ToolTip="Pesquisar pelo nome ou pela rocha" />
            <ComboBox x:Name="KindFilter" Grid.Row="1" Margin="0,4,0,0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filtrar por tipo" />
            <ComboBox x:Name="UseFilter" Grid.Row="2" Margin="0,4,0,0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filtrar por uso" />
            <ListBox x:Name="MaterialList" Grid.Row="3" Margin="0,6,0,0" SelectionChanged="MaterialList_Changed" AutomationProperties.Name="Pedras e coberturas da biblioteca" />
            <WrapPanel Grid.Row="4" Margin="0,6,0,0">
                <Button Content="_Novo" Click="New_Click" Margin="0" />
                <Button Content="Du_plicar" Click="Duplicate_Click" />
                <Button x:Name="DeleteButton" Content="Excluir" Click="Delete_Click" />
                <Button x:Name="RestoreButton" Content="Restaurar" Click="Restore_Click" ToolTip="Volta um material padrão aos valores originais" />
            </WrapPanel>
        </Grid>

        <!-- Editor -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="No_me" Target="{Binding ElementName=NameBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="3" TextChanged="Field_Changed" AutomationProperties.Name="Nome do material" />
                    <Label Grid.Row="1" Content="_Tipo" Target="{Binding ElementName=KindBox}" Padding="0" VerticalAlignment="Center" />
                    <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" SelectionChanged="Field_Changed" AutomationProperties.Name="Tipo do material" />
                    <Label Grid.Row="1" Grid.Column="2" Content="_Origem" Target="{Binding ElementName=OriginBox}" Padding="8,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="OriginBox" Grid.Row="1" Grid.Column="3" SelectionChanged="Field_Changed" AutomationProperties.Name="Origem do material" />
                    <Label Grid.Row="2" Content="_Rocha / matéria" Target="{Binding ElementName=RockBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="RockBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" TextChanged="Field_Changed" AutomationProperties.Name="Rocha ou matéria-prima" />
                    <Label Grid.Row="3" Content="Grão mínimo (mm)" Target="{Binding ElementName=GrainMinBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="GrainMinBox" Grid.Row="3" Grid.Column="1" TextChanged="Field_Changed" AutomationProperties.Name="Menor grão em milímetros" />
                    <Label Grid.Row="3" Grid.Column="2" Content="Grão máximo (mm)" Target="{Binding ElementName=GrainMaxBox}" Padding="8,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="GrainMaxBox" Grid.Row="3" Grid.Column="3" TextChanged="Field_Changed" AutomationProperties.Name="Maior grão em milímetros" />
                    <Label Grid.Row="4" Content="Cor" Target="{Binding ElementName=ColorBox}" Padding="0" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="4" Grid.Column="1">
                        <Border x:Name="ColorSwatch" Width="22" Height="18" BorderBrush="{DynamicResource VirBorder}" BorderThickness="1" Margin="0,0,6,0" DockPanel.Dock="Left" />
                        <TextBox x:Name="ColorBox" TextChanged="Field_Changed" AutomationProperties.Name="Cor predominante em hexadecimal" />
                    </DockPanel>
                    <Label Grid.Row="4" Grid.Column="2" Content="Cor dos grãos" Target="{Binding ElementName=GrainColorBox}" Padding="8,0,8,0" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="4" Grid.Column="3">
                        <Border x:Name="GrainSwatch" Width="22" Height="18" BorderBrush="{DynamicResource VirBorder}" BorderThickness="1" Margin="0,0,6,0" DockPanel.Dock="Left" />
                        <TextBox x:Name="GrainColorBox" TextChanged="Field_Changed" AutomationProperties.Name="Cor dos grãos no desenho em hexadecimal" />
                    </DockPanel>
                </Grid>

                <TextBlock Style="{StaticResource VirSection}" Text="Usos" />
                <WrapPanel x:Name="UsesPanel" />

                <TextBlock Style="{StaticResource VirSection}" Text="Camada e compra (referência)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Camada usual (mm)" Target="{Binding ElementName=LayerBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="LayerBox" Grid.Column="1" TextChanged="Field_Changed" AutomationProperties.Name="Espessura usual da camada em milímetros" />
                    <Label Grid.Column="2" Content="Densidade (t/m³)" Target="{Binding ElementName=DensityBox}" Padding="8,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="DensityBox" Grid.Column="3" TextChanged="Field_Changed" AutomationProperties.Name="Densidade aparente solta em toneladas por metro cúbico" />
                    <Label Grid.Row="1" Content="Vazios (%)" Target="{Binding ElementName=VoidsBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="VoidsBox" Grid.Row="1" Grid.Column="1" TextChanged="Field_Changed" AutomationProperties.Name="Índice de vazios em porcentagem" />
                    <Label Grid.Row="1" Grid.Column="2" Content="Perda e compactação (%)" Target="{Binding ElementName=WasteBox}" Padding="8,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="WasteBox" Grid.Row="1" Grid.Column="3" TextChanged="Field_Changed" AutomationProperties.Name="Perda e compactação em porcentagem" />
                    <Label Grid.Row="2" Content="Saco (kg; 0 = granel)" Target="{Binding ElementName=BagKgBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="BagKgBox" Grid.Row="2" Grid.Column="1" TextChanged="Field_Changed" AutomationProperties.Name="Peso do saco de venda em quilos" />
                    <Label Grid.Row="2" Grid.Column="2" Content="Saco (litros)" Target="{Binding ElementName=BagLitersBox}" Padding="8,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="BagLitersBox" Grid.Row="2" Grid.Column="3" TextChanged="Field_Changed" AutomationProperties.Name="Volume do saco de venda em litros" />
                    <Label Grid.Row="3" Content="Código do insumo" Target="{Binding ElementName=PriceCodeBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="PriceCodeBox" Grid.Row="3" Grid.Column="1" TextChanged="Field_Changed" AutomationProperties.Name="Código do insumo na tabela de preços" />
                </Grid>

                <TextBlock Style="{StaticResource VirSection}" Text="Observações" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalContentAlignment="Top" TextChanged="Field_Changed" AutomationProperties.Name="Uso indicado e observações" />
                <TextBlock Style="{StaticResource VirSection}" Text="Referências" />
                <TextBox x:Name="ReferencesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" VerticalContentAlignment="Top" TextChanged="Field_Changed" AutomationProperties.Name="Referências dos valores" />
                <TextBlock x:Name="ProblemText" Foreground="#A4262C" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Uso, prévia e compra -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="_Uso no projeto" Target="{Binding ElementName=UseBox}" Padding="0" />
                <ComboBox x:Name="UseBox" SelectionChanged="Use_Changed" AutomationProperties.Name="Uso no projeto" />
                <Border BorderBrush="{DynamicResource VirBorder}" BorderThickness="1" Margin="0,6,0,0">
                    <c:PavingSwatch x:Name="Swatch" Height="220" WidthMm="1000" />
                </Border>
                <TextBlock x:Name="SwatchText" Style="{StaticResource VirHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Style="{StaticResource VirSection}" Text="Quanto comprar" />
                <DockPanel>
                    <Label Content="Área (m²)" Target="{Binding ElementName=AreaBox}" Padding="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBox x:Name="AreaBox" Text="10" TextChanged="Area_Changed" AutomationProperties.Name="Área a cobrir em metros quadrados" />
                </DockPanel>
                <TextBlock x:Name="PurchaseText" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Style="{StaticResource VirSection}" Text="Borda de caminho" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Largura (cm)" Target="{Binding ElementName=BorderWidthBox}" Padding="0" VerticalAlignment="Center" />
                    <TextBox x:Name="BorderWidthBox" Grid.Column="1" Text="30" AutomationProperties.Name="Largura da faixa de borda em centímetros" />
                    <Label Grid.Row="1" Content="Lado" Target="{Binding ElementName=BorderSideBox}" Padding="0" VerticalAlignment="Center" />
                    <ComboBox x:Name="BorderSideBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Lado da faixa de borda" />
                </Grid>
                <TextBlock Style="{StaticResource VirHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Selecione o caminho (piso ou região) para a faixa contornar, ou linhas desenhadas ao longo da borda. Se a faixa sair do lado errado, desfaça (Ctrl+Z) e escolha o outro lado." />
                <TextBlock x:Name="ProjectHint" Style="{StaticResource VirHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Ações -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="_Salvar na biblioteca" Click="Save_Click" Style="{StaticResource VirPrimaryButton}" Margin="0" DockPanel.Dock="Left" />
            <Button Content="Fechar" IsCancel="True" DockPanel.Dock="Right" />
            <Button x:Name="DetailButton" Content="_Detalhe em corte" Click="Detail_Click" DockPanel.Dock="Right" ToolTip="Vista de desenho com as camadas do uso escolhido" />
            <Button x:Name="RegionButton" Content="_Hachura para plantas" Click="Region_Click" DockPanel.Dock="Right" ToolTip="Tipo de região preenchida com a cor e os grãos, para desenhar em planta" />
            <Button x:Name="TypeButton" Content="Criar _tipo de piso" Click="Type_Click" DockPanel.Dock="Right" ToolTip="Tipo de piso do Revit com as camadas do uso escolhido" />
            <Button x:Name="BorderButton" Content="_Borda de caminho" Click="Border_Click" DockPanel.Dock="Right" ToolTip="Cria a faixa de borda como piso do Revit ao longo do caminho escolhido" />
            <Button x:Name="FillButton" Content="_Cobrir região" Click="Fill_Click" DockPanel.Dock="Right" ToolTip="Cria a cobertura como piso do Revit numa região (canteiro, área, ambiente ou contorno desenhado)" />
            <Button x:Name="ApplyButton" Content="_Aplicar aos pisos selecionados" Click="Apply_Click" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</ui:ViridianWindow>
