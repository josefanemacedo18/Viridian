<ui:ViridianWindow x:Class="Viridian.UI.Windows.SheetWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   Title="Viridian — Prancha de paisagismo"
                   Width="560" SizeToContent="Height" MinWidth="500" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Style="{StaticResource VirHeader}" Text="Prancha de paisagismo" />
        <TextBlock x:Name="ViewText" Style="{StaticResource VirHint}" Margin="0,0,0,8" />
        <GroupBox Header="Folha">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="_Carimbo (folha)" Target="{Binding ElementName=TitleBlockBox}" Padding="0" VerticalAlignment="Center" />
                <ComboBox x:Name="TitleBlockBox" Grid.Column="1" AutomationProperties.Name="Carimbo" />
                <Label Grid.Row="1" Content="_Número" Target="{Binding ElementName=NumberBox}" Padding="0" VerticalAlignment="Center" />
                <TextBox x:Name="NumberBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Número da prancha" />
                <Label Grid.Row="2" Content="N_ome" Target="{Binding ElementName=NameBox}" Padding="0" VerticalAlignment="Center" />
                <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Nome da prancha" />
                <Label Grid.Row="3" Content="Altura do carimbo (mm)" Target="{Binding ElementName=StampBox}" Padding="0" VerticalAlignment="Center" />
                <TextBox x:Name="StampBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Altura reservada ao carimbo em milímetros"
                         ToolTip="Espaço deixado livre no canto inferior direito, abaixo da legenda e da tabela" />
            </Grid>
        </GroupBox>
        <GroupBox Header="Conteúdo">
            <StackPanel>
                <CheckBox x:Name="LegendBox" Content="Legenda de vegetação (símbolo, código, nomes e quantidade)" IsChecked="True" />
                <CheckBox x:Name="ScheduleBox" Content="Tabela de quantitativos por espécie" IsChecked="True" />
                <CheckBox x:Name="PhotoBoardBox" Content="Quadro de fotos das espécies ao redor da planta" IsChecked="True" />
                <CheckBox x:Name="FitBox" Content="Reduzir a escala da planta se ela não couber na folha" IsChecked="True" />
            </StackPanel>
        </GroupBox>
        <TextBlock Style="{StaticResource VirHint}" Margin="0,6,0,0"
                   Text="A planta fica à esquerda; a legenda e a tabela, na coluna da direita, acima do carimbo. Margens conforme a NBR 10068 (25 mm à esquerda e 10 mm nas demais)." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Criar prancha" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</ui:ViridianWindow>
