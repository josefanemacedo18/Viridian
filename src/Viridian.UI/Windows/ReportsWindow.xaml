<ui:ViridianWindow x:Class="Viridian.UI.Windows.ReportsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   Title="Viridian — Quantitativos, orçamento e manutenção"
                   Width="1180" Height="680" MinWidth="900" MinHeight="500">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource VirHeader}" Text="Quantitativos, orçamento e manutenção" Margin="0" />
            <TextBlock x:Name="ProjectText" Style="{StaticResource VirHint}" Margin="0,2,0,8" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem x:Name="SpeciesTab" Header="Por espécie">
                <DataGrid x:Name="SpeciesGrid" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="70" />
                        <DataGridTextColumn Header="Nome popular" Binding="{Binding PopularName}" Width="*" />
                        <DataGridTextColumn Header="Nome científico" Binding="{Binding ScientificName}" Width="*" FontStyle="Italic" />
                        <DataGridTextColumn Header="Novos" Binding="{Binding New, StringFormat=N0}" Width="64" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Existentes" Binding="{Binding Existing, StringFormat=N0}" Width="74" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Transplant." Binding="{Binding Transplanted, StringFormat=N0}" Width="78" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Removidos" Binding="{Binding Removed, StringFormat=N0}" Width="76" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Em maciços" Binding="{Binding InMassings, StringFormat=N0}" Width="80" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N0}" Width="70" FontWeight="SemiBold" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="MassingTab" Header="Maciços">
                <DataGrid x:Name="MassingGrid" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Maciço" Binding="{Binding Id}" Width="74" />
                        <DataGridTextColumn Header="Espécie" Binding="{Binding SpeciesCode}" Width="70" />
                        <DataGridTextColumn Header="Nome popular" Binding="{Binding PopularName}" Width="*" />
                        <DataGridTextColumn Header="Área (m²)" Binding="{Binding AreaM2, StringFormat=N2}" Width="84" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Densidade" Binding="{Binding DensityPerM2, StringFormat=N2}" Width="78" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Espaç. (m)" Binding="{Binding SpacingM, StringFormat=N2}" Width="74" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantity, StringFormat=N0}" Width="84" FontWeight="SemiBold" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="66" />
                        <DataGridTextColumn Header="Reserva %" Binding="{Binding ReservePercent, StringFormat=N0}" Width="72" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Representação" Binding="{Binding Mode}" Width="150" />
                        <DataGridTextColumn Header="Vista" Binding="{Binding ViewName}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="AcquisitionTab" Header="Aquisição">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="AcquisitionGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="70" />
                            <DataGridTextColumn Header="Nome popular" Binding="{Binding PopularName}" Width="*" />
                            <DataGridTextColumn Header="Nome científico" Binding="{Binding ScientificName}" Width="*" FontStyle="Italic" />
                            <DataGridTextColumn Header="Projeto" Binding="{Binding Quantity, StringFormat=N0}" Width="70" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Reserva" Binding="{Binding Reserve, StringFormat=N0}" Width="64" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Compra" Binding="{Binding PurchaseQuantity, StringFormat=N0}" Width="70" FontWeight="SemiBold" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="66" />
                            <DataGridTextColumn Header="Preço unit." Binding="{Binding UnitPrice, StringFormat=C2}" Width="90" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="104" FontWeight="SemiBold" ElementStyle="{StaticResource VirRightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="AcquisitionTotal" Grid.Row="1" Style="{StaticResource VirValue}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                </Grid>
            </TabItem>
            <TabItem x:Name="PurchasesTab" Header="Compras">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource VirHint}" TextWrapping="Wrap"
                                   Text="Registre o que já foi comprado: o comparativo mostra o que falta comprar e o que sobra depois de substituições ou exclusões de espécies. Digite a quantidade na coluna Comprado. O registro fica gravado no projeto." />
                        <WrapPanel Margin="0,6,0,6">
                            <Button Content="_Marcar a lista atual como comprada" Click="PurchaseAll_Click" Margin="0"
                                    ToolTip="Preenche Comprado com a quantidade de compra de cada item" />
                            <Button Content="Completar só o que _falta" Click="PurchaseMissing_Click"
                                    ToolTip="Acrescenta às compras apenas a diferença dos itens em falta" />
                            <Button Content="_Zerar compras" Click="PurchaseClear_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="PurchaseGrid" Grid.Row="1" IsReadOnly="False" CellEditEnding="PurchaseGrid_CellEditEnding"
                              AutomationProperties.Name="Comparativo entre o projeto e as compras">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nome popular" Binding="{Binding PopularName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nome científico" Binding="{Binding ScientificName}" Width="*" FontStyle="Italic" IsReadOnly="True" />
                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="66" IsReadOnly="True" />
                            <DataGridTextColumn Header="Necessário" Binding="{Binding Needed, StringFormat=N0}" Width="84" IsReadOnly="True" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Comprado" Binding="{Binding Purchased, UpdateSourceTrigger=LostFocus}" Width="84" FontWeight="SemiBold" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Diferença" Binding="{Binding Difference, StringFormat=+#;-#;0}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="190" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PurchaseSummary" Grid.Row="2" Style="{StaticResource VirValue}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                </Grid>
            </TabItem>
            <TabItem x:Name="BudgetTab" Header="Orçamento">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TableText" Style="{StaticResource VirValue}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="_Importar tabela de preços..." Click="ImportTable_Click"
                                        ToolTip="Planilha .xlsx ou .csv com colunas de código, descrição, unidade e preço (SINAPI, tabela municipal ou própria)" />
                                <Button x:Name="RemoveTableButton" Content="Remover tabela" Click="RemoveTable_Click" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <Label Content="_BDI (%)" Target="{Binding ElementName=BdiBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="BdiBox" Width="60" TextChanged="Budget_Changed" AutomationProperties.Name="BDI em porcentagem" />
                            <Label Content="_Referência" Target="{Binding ElementName=ReferenceBox}" Padding="0" VerticalAlignment="Center" Margin="16,0,6,0" />
                            <TextBox x:Name="ReferenceBox" Width="260" TextChanged="Budget_Changed" AutomationProperties.Name="Referência da tabela de preços"
                                     ToolTip="Base, local e data da tabela (por exemplo, SINAPI SP 03/2026 não desonerado)" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="BudgetGrid" Grid.Row="1" SelectionChanged="BudgetGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="44" />
                            <DataGridTextColumn Header="Código" Binding="{Binding DisplayCode}" Width="84" />
                            <DataGridTextColumn Header="Fonte" Binding="{Binding SourceName}" Width="70" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Unid." Binding="{Binding Unit}" Width="50" />
                            <DataGridTextColumn Header="Qtde" Binding="{Binding Quantity, StringFormat=N2}" Width="70" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Custo unit." Binding="{Binding UnitCost, StringFormat=C2}" Width="90" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Preço c/ BDI" Binding="{Binding UnitPrice, StringFormat=C2}" Width="94" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="104" FontWeight="SemiBold" ElementStyle="{StaticResource VirRightCell}" />
                            <DataGridTextColumn Header="Observação" Binding="{Binding Note}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LinkSupplyButton" Content="Vincular _insumo..." Click="LinkSupply_Click" Margin="0"
                                    ToolTip="Procura na tabela o item de fornecimento da muda e grava o código no cadastro da espécie" />
                            <Button x:Name="LinkServiceButton" Content="Vincular _serviço..." Click="LinkService_Click"
                                    ToolTip="Procura na tabela a composição de plantio e grava o código no cadastro da espécie" />
                        </StackPanel>
                        <TextBlock x:Name="BudgetTotal" Grid.Column="1" Style="{StaticResource VirValue}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="MaintenanceTab" Header="Manutenção">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Label Content="_Mês do plantio" Target="{Binding ElementName=PlantingMonthBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="PlantingMonthBox" Width="120" SelectionChanged="Maintenance_Changed" AutomationProperties.Name="Mês previsto para o plantio" />
                        <Label Content="_Estação seca" Target="{Binding ElementName=DrySeasonBox}" Padding="0" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <TextBox x:Name="DrySeasonBox" Width="110" TextChanged="Maintenance_Changed" AutomationProperties.Name="Estação seca da região"
                                 ToolTip="Meses de estiagem da região, por exemplo mai–set (Sudeste e Centro-Oeste) ou set–fev (parte do Nordeste)" />
                    </StackPanel>
                    <DataGrid x:Name="MaintenanceGrid" Grid.Row="1" FrozenColumnCount="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fase" Binding="{Binding PhaseName}" Width="120" />
                            <DataGridTextColumn Header="Espécie" Binding="{Binding SpeciesCode}" Width="64" />
                            <DataGridTextColumn Header="Nome popular" Binding="{Binding PopularName}" Width="130" />
                            <DataGridTextColumn Header="Serviço" Binding="{Binding Title}" Width="210" />
                            <DataGridTextColumn Header="Frequência" Binding="{Binding Frequency}" Width="150" />
                            <DataGridTextColumn Header="jan" Binding="{Binding M1}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="fev" Binding="{Binding M2}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="mar" Binding="{Binding M3}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="abr" Binding="{Binding M4}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="mai" Binding="{Binding M5}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="jun" Binding="{Binding M6}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="jul" Binding="{Binding M7}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="ago" Binding="{Binding M8}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="set" Binding="{Binding M9}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="out" Binding="{Binding M10}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="nov" Binding="{Binding M11}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="dez" Binding="{Binding M12}" Width="30" ElementStyle="{StaticResource VirCenterCell}" />
                            <DataGridTextColumn Header="Observações" Binding="{Binding Notes}" Width="320" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource VirHint}" Margin="0,6,0,0"
                               Text="Recomendações gerais de boas práticas. Ajuste ao clima local, ao porte das mudas e às exigências do contratante." />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Criar tabelas nativas" Click="Schedules_Click" Margin="0"
                        ToolTip="Cria no projeto as tabelas de vegetação do Revit (por espécie e por exemplar)" />
                <Button Content="Criar legenda" Click="Legend_Click" ToolTip="Cria a vista de legenda com símbolos, nomes e quantidades" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Exportar para Excel..." Click="Export_Click" Style="{StaticResource VirPrimaryButton}" />
                <Button Content="Fechar" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:ViridianWindow>
