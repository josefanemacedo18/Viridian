<ui:ViridianWindow x:Class="Viridian.UI.Windows.LabelWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   Title="Viridian — Etiquetar"
                   Width="520" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Style="{StaticResource VirHeader}" Text="Etiquetar vegetação" />

        <GroupBox Header="O que etiquetar">
            <StackPanel>
                <RadioButton x:Name="SelectionRadio" GroupName="Scope" Checked="Input_Changed" />
                <RadioButton x:Name="ViewRadio" GroupName="Scope" Checked="Input_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="PlantsBox" Content="Exemplares" Margin="0,0,18,0" Checked="Input_Changed" Unchecked="Input_Changed" />
                    <CheckBox x:Name="MassingsBox" Content="Maciços" Checked="Input_Changed" Unchecked="Input_Changed" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Modelo de identificação">
            <StackPanel>
                <ComboBox x:Name="ModelBox" SelectionChanged="Input_Changed" />
                <TextBlock x:Name="ExampleText" Style="{StaticResource VirHint}" Margin="0,4,0,0" />
                <CheckBox x:Name="LeaderBox" Content="Linha indicadora" />
                <CheckBox x:Name="GroupBySpeciesBox" Content="Uma etiqueta por espécie, com a quantidade (ex.: 5 AR-001)" Checked="Input_Changed" Unchecked="Input_Changed" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Tipo de etiqueta dos exemplares">
            <StackPanel>
                <RadioButton x:Name="TextRadio" GroupName="Kind" Content="Etiqueta Viridian (texto vinculado ao elemento)" IsChecked="True" Checked="Input_Changed" />
                <RadioButton x:Name="TagRadio" GroupName="Kind" Content="Identificador nativo do Revit (tag de vegetação)" Checked="Input_Changed" />
                <ComboBox x:Name="TagTypeBox" Margin="18,2,0,2" />
                <TextBlock x:Name="TagHint" Style="{StaticResource VirHint}" Margin="18,2,0,0" />
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Etiquetar" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</ui:ViridianWindow>
