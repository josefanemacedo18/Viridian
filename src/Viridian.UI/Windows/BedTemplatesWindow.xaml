<ui:ViridianWindow x:Class="Viridian.UI.Windows.BedTemplatesWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Inserir modelo de canteiro"
                   Width="980" Height="600" MinWidth="820" MinHeight="460">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource VirHeader}" Text="Inserir modelo de canteiro" Margin="0" />

        <DataGrid x:Name="TemplatesGrid" Grid.Row="1" Margin="0,8,12,0" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="TemplatesGrid_SelectionChanged" MouseDoubleClick="TemplatesGrid_DoubleClick" AutomationProperties.Name="Modelos de canteiro">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" Style="{StaticResource VirValue}" TextWrapping="Wrap" />
            <Border Grid.Row="1" BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Margin="0,6,0,0">
                <c:BedPreview x:Name="Preview" />
            </Border>
            <TextBlock x:Name="SpeciesText" Grid.Row="2" Style="{StaticResource VirHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="_Girar (graus)" Target="{Binding ElementName=AngleBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="AngleBox" Grid.Column="1" Text="0" TextChanged="AngleBox_TextChanged" AutomationProperties.Name="Rotação em graus"
                     ToolTip="Positivo gira no sentido anti-horário. A prévia acompanha." />
            <TextBlock Grid.Column="2" Style="{StaticResource VirHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="Depois de confirmar, clique na planta onde fica o centro do canteiro. Espécies que não estiverem no catálogo deste computador ficam de fora (o resumo avisa)." />
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Content="E_xcluir modelo" Click="Delete_Click" Margin="0" />
            <TextBlock x:Name="FileText" Grid.Column="1" Style="{StaticResource VirHint}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="_Inserir" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
                <Button Content="Cancelar" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:ViridianWindow>
