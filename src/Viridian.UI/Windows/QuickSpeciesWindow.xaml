<ui:ViridianWindow x:Class="Viridian.UI.Windows.QuickSpeciesWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian"
                   Width="860" Height="560" MinWidth="760" MinHeight="460">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Grid.ColumnSpan="2" Style="{StaticResource VirHeader}" TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="_Pesquisar" Target="{Binding ElementName=SearchBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Search_Changed" PreviewKeyDown="SearchBox_PreviewKeyDown"
                     AutomationProperties.Name="Pesquisar espécie" ToolTip="Código, nome popular ou científico. Sem texto, aparecem as espécies usadas por último." />
        </Grid>
        <DataGrid x:Name="SpeciesGrid" Grid.Row="2" Margin="0,0,12,0" SelectionChanged="SpeciesGrid_SelectionChanged" MouseDoubleClick="SpeciesGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="14" Height="14" ToolTip="{Binding ColorTip}">
                                <Ellipse Fill="{Binding FoliageBrush}" Stroke="#55000000" StrokeThickness="0.6" />
                                <Ellipse Width="6" Height="6" Fill="{Binding FlowerBrush}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="70" />
                <DataGridTextColumn Header="Nome popular" Binding="{Binding PopularName}" Width="*" />
                <DataGridTextColumn Header="Nome científico" Binding="{Binding ScientificName}" Width="*" FontStyle="Italic" />
                <DataGridTextColumn Header="Copa" Binding="{Binding CrownText}" Width="60" ElementStyle="{StaticResource VirRightCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource VirGreenDark}" />
                <TextBlock x:Name="DetailSubtitle" FontStyle="Italic" TextWrapping="Wrap" Foreground="{StaticResource VirMuted}" Margin="0,0,0,6" />
                <Grid Height="140">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Margin="0,0,3,0">
                        <c:SymbolPreview x:Name="SymbolView" />
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Margin="3,0,0,0" Background="#FAFAFA">
                        <Grid>
                            <TextBlock x:Name="NoPhotoText" Text="Sem fotografia" Style="{StaticResource VirHint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PhotoImage" Stretch="UniformToFill" AutomationProperties.Name="Fotografia da espécie" />
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock x:Name="InfoText" Style="{StaticResource VirHint}" Margin="0,6,0,0" />

                <GroupBox x:Name="OptionsGroup" Header="Exemplares" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="_Variante" Target="{Binding ElementName=VariantBox}" Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="VariantBox" Grid.Column="1" SelectionChanged="VariantBox_SelectionChanged" AutomationProperties.Name="Variante gráfica" />
                        <Label Grid.Row="1" Content="_Situação" Target="{Binding ElementName=StatusBox}" Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="StatusBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Situação" />
                        <Label Grid.Row="2" Content="_Estágio" Target="{Binding ElementName=StageBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="StageBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Estágio de implantação" />
                        <Label Grid.Row="3" Content="_Observações" Target="{Binding ElementName=NotesBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="NotesBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Observações" />
                    </Grid>
                </GroupBox>
                <TextBlock x:Name="ActionHint" Style="{StaticResource VirHint}" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="_Biblioteca completa..." Click="Library_Click" Margin="0"
                    ToolTip="Abre a biblioteca botânica com todos os filtros e o cadastro de espécies" />
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource VirHint}" VerticalAlignment="Center" Margin="12,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="OkButton" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
                <Button Content="Cancelar" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:ViridianWindow>
