<ui:ViridianWindow x:Class="Viridian.UI.Windows.SpeciesEditorWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Espécie"
                   Width="920" Height="690" MinWidth="860" MinHeight="600">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Style="{StaticResource VirHeader}" Text="Espécie" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <GroupBox Header="Identificação">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource VirLabel}" Text="Categoria" />
                            <ComboBox x:Name="CategoryBox" Grid.Column="1" SelectionChanged="CategoryBox_SelectionChanged" />
                            <TextBlock Grid.Column="2" Style="{StaticResource VirLabel}" Text="Código" Margin="12,0,8,0" />
                            <TextBox x:Name="CodeBox" Grid.Column="3" />

                            <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Nome popular" />
                            <TextBox x:Name="PopularBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" />

                            <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Nome científico" />
                            <TextBox x:Name="ScientificBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" FontStyle="Italic" />

                            <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Família botânica" />
                            <TextBox x:Name="FamilyBox" Grid.Row="3" Grid.Column="1" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Origem" Margin="12,0,8,0" />
                            <ComboBox x:Name="OriginBox" Grid.Row="3" Grid.Column="3" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Dimensões e plantio">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource VirLabel}" Text="Altura adulta (m)" />
                            <TextBox x:Name="HeightBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Style="{StaticResource VirLabel}" Text="Copa adulta (m)" Margin="12,0,8,0" />
                            <TextBox x:Name="CrownBox" Grid.Column="3" TextChanged="Symbol_Changed" />

                            <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Altura da muda (m)" />
                            <TextBox x:Name="PlantingHeightBox" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Espaçamento (m)" Margin="12,0,8,0" />
                            <TextBox x:Name="SpacingBox" Grid.Row="1" Grid.Column="3" />

                            <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Densidade (un/m²)" />
                            <TextBox x:Name="DensityBox" Grid.Row="2" Grid.Column="1" ToolTip="Usada em maciços. Vazio = derivar do espaçamento." />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Forma da copa" Margin="12,0,8,0" />
                            <ComboBox x:Name="FormBox" Grid.Row="2" Grid.Column="3" />

                            <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Fornecimento" />
                            <ComboBox x:Name="UnitBox" Grid.Row="3" Grid.Column="1" IsEditable="True" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Preço unitário (R$)" Margin="12,0,8,0" />
                            <TextBox x:Name="PriceBox" Grid.Row="3" Grid.Column="3" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Características">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource VirLabel}" Text="Crescimento" />
                            <ComboBox x:Name="GrowthBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Style="{StaticResource VirLabel}" Text="Água" Margin="12,0,8,0" />
                            <ComboBox x:Name="WaterBox" Grid.Column="3" />

                            <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Luminosidade" />
                            <ComboBox x:Name="LightBox" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Floração" Margin="12,0,8,0" />
                            <TextBox x:Name="FloweringBox" Grid.Row="1" Grid.Column="3" ToolTip="Meses de floração, por exemplo ago–out, set–nov e mar–abr, ano todo" />

                            <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Textura da folhagem" />
                            <ComboBox x:Name="TextureBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Textura da folhagem"
                                      ToolTip="Fina: folhas miúdas ou recortadas. Grossa: folhas grandes e marcantes. Usada nas regras de composição." />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Escala visual" Margin="12,0,8,0" />
                            <TextBlock x:Name="ScaleText" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource VirMuted}"
                                       ToolTip="Calculada pela altura e pela copa adultas" />

                            <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Tolera encharcamento" />
                            <ComboBox x:Name="WaterloggingBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Tolerância ao encharcamento"
                                      ToolTip="Usada no jardim de chuva: alta para o fundo (alagamento), média para os taludes, baixa para as bordas. Não informada: só aquáticas são presumidas tolerantes." />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Folhagem" Margin="12,0,8,0" />
                            <ComboBox x:Name="LeafHabitBox" Grid.Row="3" Grid.Column="3" AutomationProperties.Name="Folhagem ao longo do ano"
                                      ToolTip="Decíduas e semidecíduas fazem sombra mais rala nos meses sem folhas (estudo solar)." />

                            <TextBlock Grid.Row="4" Style="{StaticResource VirLabel}" Text="Tolera seca" />
                            <ComboBox x:Name="DroughtBox" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Tolerância à seca"
                                      ToolTip="Independente da necessidade de água e do encharcamento: o quanto a planta aguenta estiagem depois de estabelecida." />
                            <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource VirHint}" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="Água, seca e encharcamento são independentes: pedir rega não quer dizer tolerar solo encharcado." />
                            <TextBlock Grid.Row="5" Style="{StaticResource VirLabel}" Text="Perfil 3D" />
                            <ComboBox x:Name="Profile3DBox" Grid.Row="5" Grid.Column="1" AutomationProperties.Name="Perfil 3D da maquete"
                                      ToolTip="Forma da planta na maquete 3D (motor botânico). Automático: escolhido pelo gênero, pela categoria e pela forma da copa." />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Meses sem folhas" Margin="12,0,8,0" />
                            <TextBox x:Name="LeaflessBox" Grid.Row="5" Grid.Column="3" AutomationProperties.Name="Meses sem folhas"
                                     ToolTip="Para decíduas e semidecíduas, por exemplo jul–set. Vazio: jun–ago (jul–set nos ipês)." />

                            <TextBlock Grid.Row="6" Style="{StaticResource VirLabel}" Text="Frutificação" />
                            <TextBox x:Name="FruitingBox" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Meses de frutificação"
                                     ToolTip="Meses com frutos maduros, por exemplo nov–jan. Vazio: estimada pelo gênero quando houver referência (maquete 3D)." />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Cor do fruto" Margin="12,0,8,0" />
                            <Grid Grid.Row="6" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FruitColorBox" TextChanged="Symbol_Changed" AutomationProperties.Name="Cor do fruto"
                                         ToolTip="#RRGGBB. Vazio: cor de referência do gênero (quando houver)." />
                                <Button Grid.Column="1" Margin="4,0,0,0" Padding="0" Tag="fruto" Click="PickColor_Click" Cursor="Hand"
                                        ToolTip="Clique para escolher a cor (paleta, conta-gotas na foto ou código)" AutomationProperties.Name="Escolher a cor do fruto">
                                    <Border x:Name="FruitSwatch" Width="26" Height="18" BorderBrush="#999" BorderThickness="1" />
                                </Button>
                            </Grid>

                            <TextBlock x:Name="Season3DText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource VirHint}" TextWrapping="Wrap" Margin="0,2,0,4" />

                            <TextBlock Grid.Row="8" Style="{StaticResource VirLabel}" Text="Observações" VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox x:Name="NotesBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="48" MaxHeight="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Biomas, cores e orçamento">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource VirLabel}" Text="Biomas de ocorrência" VerticalAlignment="Top" Margin="0,5,8,0" />
                            <WrapPanel x:Name="BiomePanel" Grid.Column="1" Grid.ColumnSpan="3" />

                            <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Cor da folhagem" />
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FoliageColorBox" TextChanged="Symbol_Changed" AutomationProperties.Name="Cor da folhagem"
                                         ToolTip="Clique no quadrado ao lado para escolher. Vazio = variação da cor da categoria (Configurações, aba Cores)." />
                                <Button Grid.Column="1" Margin="4,0,0,0" Padding="0" Tag="folhagem" Click="PickColor_Click" Cursor="Hand"
                                        ToolTip="Clique para escolher a cor (paleta, conta-gotas na foto ou código)" AutomationProperties.Name="Escolher a cor">
                                    <Border x:Name="FoliageSwatch" Width="26" Height="18" BorderBrush="#999" BorderThickness="1" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Cor da flor" Margin="12,0,8,0" />
                            <Grid Grid.Row="1" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FlowerColorBox" TextChanged="Symbol_Changed" AutomationProperties.Name="Cor da flor"
                                         ToolTip="Clique no quadrado ao lado para escolher. Vazio = espécie sem floração vistosa." />
                                <Button Grid.Column="1" Margin="4,0,0,0" Padding="0" Tag="flor" Click="PickColor_Click" Cursor="Hand"
                                        ToolTip="Clique para escolher a cor (paleta, conta-gotas na foto ou código)" AutomationProperties.Name="Escolher a cor">
                                    <Border x:Name="FlowerSwatch" Width="26" Height="18" BorderBrush="#999" BorderThickness="1" />
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Código do insumo" />
                            <TextBox x:Name="PriceCodeBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Código do insumo na tabela de preços"
                                     ToolTip="Código da muda na tabela de preços importada (por exemplo, SINAPI ou tabela própria)." />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource VirLabel}" Text="Código do serviço" Margin="12,0,8,0" />
                            <TextBox x:Name="ServiceCodeBox" Grid.Row="2" Grid.Column="3" AutomationProperties.Name="Código do serviço de plantio na tabela de preços"
                                     ToolTip="Código do serviço de plantio na tabela de preços importada." />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Arquivos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource VirLabel}" Text="Fotografia" />
                            <TextBlock x:Name="PhotoText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="Procurar..." Click="PhotoBrowse_Click" MinWidth="76" />
                            <Button Grid.Column="3" Content="Remover" Click="PhotoRemove_Click" MinWidth="70" />
                            <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Crédito da foto" Margin="0,6,8,0" />
                            <TextBox x:Name="PhotoCreditBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                     AutomationProperties.Name="Crédito da fotografia" ToolTip="Autor ou fonte da foto (aparece na ficha, na legenda e no memorial)" />

                            <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Família Vegetação" Margin="0,6,8,0" />
                            <TextBlock x:Name="CustomFamilyText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                            <Button x:Name="CustomFamilyRemove" Grid.Row="1" Grid.Column="3" Content="Remover" Click="CustomFamilyRemove_Click" MinWidth="70" Margin="4,6,0,0" />

                            <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Símbolo de maciço" Margin="0,6,8,0" />
                            <TextBlock x:Name="CustomDetailText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                            <Button x:Name="CustomDetailRemove" Grid.Row="2" Grid.Column="3" Content="Remover" Click="CustomDetailRemove_Click" MinWidth="70" Margin="4,6,0,0" />
                        </Grid>
                    </GroupBox>
                    <TextBlock Style="{StaticResource VirHint}" Text="Famílias personalizadas são associadas pela ferramenta Importar Família." />
                </StackPanel>
            </ScrollViewer>

            <!-- Representação gráfica -->
            <Border Grid.Column="1" Style="{StaticResource VirCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Símbolo em planta" />
                    <ComboBox x:Name="StyleBox" SelectionChanged="Symbol_Changed" />
                    <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Height="200" Margin="0,6,0,0">
                        <c:SymbolPreview x:Name="SymbolView" />
                    </Border>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileBox" Margin="0,2,3,2" SelectionChanged="Symbol_Changed" ToolTip="Perfil de representação da pré-visualização" />
                        <ComboBox x:Name="VariantViewBox" Grid.Column="1" Margin="3,2,0,2" SelectionChanged="Symbol_Changed" ToolTip="Variante exibida" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Variantes gráficas" />
                        <ComboBox x:Name="VariantsBox" Grid.Column="1" SelectionChanged="Variants_Changed" />
                        <Button Grid.Column="2" Content="Novo desenho" Click="NewSeed_Click" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Style="{StaticResource VirSection}" Text="Hachura em maciços" />
                    <ComboBox x:Name="HatchBox" SelectionChanged="Hatch_Changed" />
                    <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Height="90" Margin="0,6,0,0">
                        <c:HatchPreview x:Name="HatchView" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Gravar" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:ViridianWindow>
