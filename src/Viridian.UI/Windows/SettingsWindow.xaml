<ui:ViridianWindow x:Class="Viridian.UI.Windows.SettingsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Configurações"
                   Width="820" Height="600" MinWidth="760" MinHeight="540">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource VirHeader}" Text="Configurações do escritório" />

        <TabControl Grid.Row="1" TabStripPlacement="Left">
            <!-- Biblioteca -->
            <TabItem Header="Biblioteca">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Pasta da biblioteca" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LibraryBox" />
                        <Button Grid.Column="1" Content="Procurar..." Click="LibraryBrowse_Click" MinWidth="76" />
                        <Button Grid.Column="2" Content="Padrão" Click="LibraryDefault_Click" MinWidth="60" />
                    </Grid>
                    <TextBlock Style="{StaticResource VirHint}" Text="Use uma pasta de rede para compartilhar o catálogo, as famílias e os símbolos entre os computadores do escritório." />

                    <TextBlock Style="{StaticResource VirSection}" Text="Modelo de família para gerar os símbolos (.rft)" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TemplateBox" />
                        <Button Grid.Column="1" Content="Procurar..." Click="TemplateBrowse_Click" MinWidth="76" />
                        <Button Grid.Column="2" Content="Automático" Click="TemplateAuto_Click" MinWidth="76" />
                    </Grid>
                    <TextBlock Style="{StaticResource VirHint}" Text="Vazio = localizar automaticamente um modelo de Vegetação ou de Modelo genérico instalado com o Revit." />

                    <TextBlock Style="{StaticResource VirSection}" Text="Arquivos" />
                    <TextBlock x:Name="FilesText" Style="{StaticResource VirHint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Abrir pasta da biblioteca" Click="OpenLibrary_Click" Margin="0" />
                        <Button Content="Abrir pasta de configurações" Click="OpenConfig_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Escalas -->
            <TabItem Header="Escalas">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Faixas de escala de cada perfil" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Detalhado" />
                        <TextBlock Grid.Column="1" Style="{StaticResource VirLabel}" Text="até 1:" />
                        <TextBox x:Name="DetailedBox" Grid.Column="2" TextChanged="Scale_Changed" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Intermediário" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource VirLabel}" Text="até 1:" />
                        <TextBox x:Name="IntermediateBox" Grid.Row="1" Grid.Column="2" TextChanged="Scale_Changed" />
                        <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Simplificado" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource VirLabel}" Text="até 1:" />
                        <TextBox x:Name="SimplifiedBox" Grid.Row="2" Grid.Column="2" TextChanged="Scale_Changed" />
                        <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Mínimo" />
                        <TextBlock x:Name="MinimalText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,6" />
                    </Grid>
                    <CheckBox x:Name="AutoScaleBox" Content="Atualizar automaticamente quando a escala de uma vista mudar" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Padrão gráfico -->
            <TabItem Header="Padrão gráfico">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Espessura e cor de cada camada dos símbolos" />
                    <ItemsControl x:Name="TierList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Weights}" SelectedItem="{Binding LineWeight}" Margin="0,2,8,2" ToolTip="Espessura de linha do Revit (1 a 16)" />
                                    <TextBox Grid.Column="2" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cor em hexadecimal, por exemplo #2F6B4F" />
                                    <Border Grid.Column="3" Margin="6,4,0,4" BorderBrush="#999" BorderThickness="1" Background="{Binding Swatch}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox x:Name="SyncMarksBox" Content="Gravar o código da espécie em &quot;Marca de tipo&quot; e o do exemplar em &quot;Marca&quot;" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource VirHint}" Text="Permite usar identificadores e tabelas padrão do Revit que leem esses parâmetros." />
                </StackPanel>
            </TabItem>

            <!-- Cores -->
            <TabItem Header="Cores">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Copas e floração" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="_Preenchimento da copa" Target="{Binding ElementName=CrownFillBox}" Padding="0" VerticalAlignment="Center" />
                            <ComboBox x:Name="CrownFillBox" Grid.Column="1" SelectionChanged="ColorSelection_Changed" AutomationProperties.Name="Preenchimento da copa" />
                            <Label Grid.Row="1" Content="C_lareamento da copa (%)" Target="{Binding ElementName=CrownTintBox}" Padding="0" VerticalAlignment="Center" />
                            <TextBox x:Name="CrownTintBox" Grid.Row="1" Grid.Column="1" TextChanged="ColorText_Changed" AutomationProperties.Name="Clareamento da copa em porcentagem" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource VirHint}" Margin="8,0,0,0" VerticalAlignment="Center" Text="0 = cor da folhagem; 85 = quase branco" />
                            <Label Grid.Row="2" Content="Clareamento do _fundo dos maciços (%)" Target="{Binding ElementName=MassingTintBox}" Padding="0" VerticalAlignment="Center" />
                            <TextBox x:Name="MassingTintBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Clareamento do fundo dos maciços em porcentagem" />
                        </Grid>
                        <CheckBox x:Name="ShowFlowersBox" Content="Representar a floração das espécies com cor de flor cadastrada" Margin="0,8,0,0" Checked="ColorCheck_Changed" Unchecked="ColorCheck_Changed" />
                        <CheckBox x:Name="ColoredMassingsBox" Content="Pintar os maciços com a cor da espécie (fundo claro e hachura mais escura)" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource VirSection}" Text="Cor-base de cada categoria" />
                        <TextBlock Style="{StaticResource VirHint}" Text="Cada espécie recebe uma variação suave da cor da sua categoria, salvo quando tem cor de folhagem própria no cadastro." />
                        <ItemsControl x:Name="CategoryColorList" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cor em hexadecimal, por exemplo #4E8A3E" AutomationProperties.Name="{Binding Name}" />
                                        <Border Grid.Column="2" Margin="6,4,0,4" BorderBrush="#999" BorderThickness="1" Background="{Binding Swatch}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Restaurar cores padrão" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ColorDefaults_Click" />

                        <TextBlock Style="{StaticResource VirSection}" Text="Pré-visualização" />
                        <WrapPanel x:Name="ColorPreviewPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Interferências -->
            <TabItem Header="Interferências">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Distância mínima do tronco (m)" />
                        <TextBlock Style="{StaticResource VirHint}" Text="Valores de referência de manuais de arborização urbana. Ajuste às normas do município e das concessionárias. Zero = não verificar." />
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Elemento" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Árvores" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Palmeiras" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Arbustos" FontWeight="SemiBold" />
                        </Grid>
                        <ItemsControl x:Name="InterferenceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" ToolTip="Verificar este tipo de elemento" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2" Text="{Binding Tree, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,8,2" AutomationProperties.Name="Distância para árvores" />
                                        <TextBox Grid.Column="3" Text="{Binding Palm, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,8,2" AutomationProperties.Name="Distância para palmeiras" />
                                        <TextBox Grid.Column="4" Text="{Binding Shrub, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,8,2" AutomationProperties.Name="Distância para arbustos" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Fração do raio da copa até a fachada" Target="{Binding ElementName=CrownFactorBox}" Padding="0" VerticalAlignment="Center" />
                            <TextBox x:Name="CrownFactorBox" Grid.Column="1" Margin="0,2,8,2" AutomationProperties.Name="Fração do raio da copa até a fachada"
                                     ToolTip="0,75 = três quartos do raio da copa adulta devem caber entre o tronco e a parede" />
                        </Grid>
                        <CheckBox x:Name="PavementBox" Content="Apontar árvores, palmeiras e arbustos plantados sobre pisos sem abertura (berço)" Margin="0,8,0,0" />
                        <CheckBox x:Name="LinksBox" Content="Ler também os modelos vinculados (instalações, arquitetura, infraestrutura)" />
                        <CheckBox x:Name="InterferenceEnabledBox" Content="Incluir as interferências em &quot;Verificar Projeto&quot;" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Acessibilidade -->
            <TabItem Header="Acessibilidade">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Janelas do Viridian" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Label Content="_Tamanho do texto e dos controles" Target="{Binding ElementName=TextScaleBox}" Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="TextScaleBox" Grid.Column="1" AutomationProperties.Name="Tamanho do texto e dos controles" />
                    </Grid>
                    <CheckBox x:Name="HighContrastBox" Content="Cores de alto contraste" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource VirHint}" Margin="0,4,0,0"
                               Text="O alto contraste do Windows é seguido automaticamente. As mudanças valem a partir da próxima janela aberta." />
                    <TextBlock Style="{StaticResource VirSection}" Text="Teclado" />
                    <TextBlock Style="{StaticResource VirHint}"
                               Text="Use Tab para navegar entre os campos e Alt + a letra sublinhada para ir direto a um campo. Enter confirma e Esc cancela." />
                </StackPanel>
            </TabItem>

            <!-- Composição e especificações -->
            <TabItem Header="Composição">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Regras de composição dos canteiros" />
                        <TextBlock Style="{StaticResource VirHint}" Text="São recomendações: aparecem em Verificar Canteiro e nunca impedem o projeto." />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="RuleShareBox" Content="Participação máxima de uma espécie (%)" />
                            <TextBox x:Name="MaxShareBox" Grid.Column="1" AutomationProperties.Name="Participação máxima de uma espécie em porcentagem" />
                            <CheckBox x:Name="RuleDiversityBox" Grid.Row="1" Content="Mínimo de espécies por canteiro" />
                            <TextBox x:Name="MinSpeciesBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Mínimo de espécies por canteiro" />
                            <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="   ... a partir de (m²)" />
                            <TextBox x:Name="MinAreaBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Área mínima para exigir diversidade" />
                            <CheckBox x:Name="RuleScaleBox" Grid.Row="3" Content="Copa adulta até (% da menor dimensão do canteiro)" />
                            <TextBox x:Name="MaxCrownBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Copa adulta em porcentagem da menor dimensão do canteiro" />
                        </Grid>
                        <CheckBox x:Name="RuleTextureBox" Content="Contraste de texturas (ao menos duas texturas em canteiros com 3 ou mais espécies)" />
                        <CheckBox x:Name="RulePalmBox" Content="Palmeiras com plantio de base (sub-bosque)" />
                        <CheckBox x:Name="RuleFloweringBox" Content="Floração distribuída ao longo do ano" />

                        <TextBlock Style="{StaticResource VirSection}" Text="Notas de especificação de plantio" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="_Modelo" Target="{Binding ElementName=SpecKindBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="SpecKindBox" Grid.Column="1" SelectionChanged="SpecKind_Changed" AutomationProperties.Name="Modelo de nota de especificação" />
                            <Button Grid.Column="2" Content="Restaurar texto padrão" Click="SpecDefault_Click" />
                        </Grid>
                        <TextBox x:Name="SpecTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Margin="0,6,0,0" TextChanged="SpecText_Changed" AutomationProperties.Name="Texto da nota de especificação" />
                        <TextBlock x:Name="SpecFieldsText" Style="{StaticResource VirHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Maciços -->
            <TabItem Header="Maciços">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Representação conforme a densidade (un/m²)" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Baixa (símbolos individuais) até" />
                        <TextBox x:Name="LowBox" Grid.Column="1" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Média (símbolos + hachura) até" />
                        <TextBox x:Name="MediumBox" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Alta (hachura + quantidade) até" />
                        <TextBox x:Name="HighBox" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource VirHint}" Text="Acima do último limite: hachura simplificada." Margin="0,4,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource VirSection}" Text="Identificação e aquisição" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Prefixo dos maciços" />
                        <TextBox x:Name="PrefixBox" Grid.Column="1" MaxLength="6" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Reserva padrão de maciços (%)" />
                        <TextBox x:Name="MassingReserveBox" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Reserva de exemplares isolados (%)" />
                        <TextBox x:Name="IndividualReserveBox" Grid.Row="2" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Plantio -->
            <TabItem Header="Plantio">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Valores iniciais da distribuição" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Afastamento das bordas (m)" />
                        <TextBox x:Name="EdgeBox" Grid.Column="1" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Variação de posição (%)" />
                        <TextBox x:Name="JitterBox" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Quantidade máxima por operação" />
                        <TextBox x:Name="MaxCountBox" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Deslocamento vertical dos exemplares (m)" />
                        <TextBox x:Name="ElevationBox" Grid.Row="3" Grid.Column="1" ToolTip="Altura dos exemplares em relação ao nível da vista" />
                    </Grid>
                    <CheckBox x:Name="RotationBox" Content="Girar os exemplares aleatoriamente" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Codificação -->
            <TabItem Header="Codificação">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Código dos exemplares no projeto" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Formato" />
                        <TextBox x:Name="CodeTemplateBox" Grid.Column="1" TextChanged="Code_Changed" />
                        <TextBlock Grid.Column="2" Style="{StaticResource VirLabel}" Text="Dígitos" Margin="12,0,8,0" />
                        <ComboBox x:Name="DigitsBox" Grid.Column="3" SelectionChanged="Code_Changed" />
                    </Grid>
                    <TextBlock Style="{StaticResource VirHint}" Text="Marcadores: {CAT} prefixo da categoria, {ESP} código da espécie, {N} número sequencial (obrigatório)." />
                    <TextBlock x:Name="CodeExample" Style="{StaticResource VirHint}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource VirSection}" Text="Códigos de espécie" />
                    <TextBlock Style="{StaticResource VirHint}" Text="AR árvore · PA palmeira · AB arbusto · HE herbácea · FO forração · GR gramado · TR trepadeira · AQ aquática" />
                </StackPanel>
            </TabItem>

            <!-- Análise -->
            <TabItem Header="Análise">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Tolerâncias das verificações" />
                    <CheckBox x:Name="CheckCrownBox" Content="Verificar conflitos de copa" />
                    <CheckBox x:Name="CheckSpacingBox" Content="Verificar espaçamento recomendado" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Sobreposição de copas tolerada (%)" />
                        <TextBox x:Name="OverlapBox" Grid.Column="1" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Copa mínima verificada (m)" />
                        <TextBox x:Name="MinCrownBox" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Redução tolerada do espaçamento (%)" />
                        <TextBox x:Name="SpacingTolBox" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Distância de elemento duplicado (m)" />
                        <TextBox x:Name="DuplicateBox" Grid.Row="3" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Etiquetas -->
            <TabItem Header="Etiquetas">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Etiquetas Viridian" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Altura do texto no papel (mm)" />
                        <TextBox x:Name="TextSizeBox" Grid.Column="1" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Distância ao elemento no papel (mm)" />
                        <TextBox x:Name="OffsetBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <CheckBox x:Name="LeaderBox" Content="Linha indicadora por padrão" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Hachuras -->
            <TabItem Header="Hachuras">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource VirSection}" Margin="0,0,0,4" Text="Hachuras disponíveis (as do escritório podem ser removidas)" />
                    <ListBox x:Name="HatchList" Grid.Row="1" SelectionChanged="HatchList_SelectionChanged" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                        <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Height="150">
                            <c:HatchPreview x:Name="HatchView" />
                        </Border>
                        <TextBlock x:Name="HatchInfo" Style="{StaticResource VirHint}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Importar arquivo .pat..." Click="HatchImport_Click" Margin="0" />
                        <Button x:Name="HatchRemoveButton" Content="Remover" Click="HatchRemove_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Restaurar padrões" Click="Defaults_Click" />
            <Button Content="Gravar" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:ViridianWindow>
