<ui:ViridianWindow x:Class="Viridian.UI.Windows.TextPromptWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   Title="Viridian" Width="460" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="HeaderText" Style="{StaticResource VirHeader}" TextWrapping="Wrap" />
        <TextBlock x:Name="NameLabel" Style="{StaticResource VirLabel}" Margin="0,4,0,2" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="Nome" />
        <TextBlock x:Name="DetailLabel" Style="{StaticResource VirLabel}" Margin="0,10,0,2" Text="Descrição (opcional)" />
        <TextBox x:Name="DetailBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Descrição" />
        <TextBlock x:Name="HintText" Style="{StaticResource VirHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Gravar" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</ui:ViridianWindow>
