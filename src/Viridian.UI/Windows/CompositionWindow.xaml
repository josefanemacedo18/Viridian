<ui:ViridianWindow x:Class="Viridian.UI.Windows.CompositionWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Compor canteiro"
                   Width="1120" Height="680" MinWidth="940" MinHeight="560">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Grid.ColumnSpan="2" Style="{StaticResource VirHeader}" Text="Compor canteiro" Margin="0" />

        <!-- Modelo e arranjo -->
        <Grid Grid.Row="1" Margin="0,6,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="_Modelo" Target="{Binding ElementName=TemplateBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="TemplateBox" Grid.Column="1" SelectionChanged="TemplateBox_SelectionChanged" AutomationProperties.Name="Modelo de canteiro"
                      ToolTip="Modelos do escritório (pasta da biblioteca): valem em qualquer projeto. Um desenho também pode ser usado como receita." />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Salvar _como modelo..." Click="SaveTemplate_Click" Margin="6,0,0,0"
                        ToolTip="Grava esta receita na biblioteca do escritório para usar em outros canteiros e projetos." />
                <Button x:Name="DeleteTemplateButton" Content="Excluir" Click="DeleteTemplate_Click" ToolTip="Exclui o modelo escolhido da biblioteca." />
            </StackPanel>
            <Label Grid.Row="1" Content="_Arranjo" Target="{Binding ElementName=LayoutBox}" Padding="0" VerticalAlignment="Center" Margin="0,8,8,0" />
            <ComboBox x:Name="LayoutBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Changed" AutomationProperties.Name="Arranjo das faixas" />
            <Button Grid.Row="1" Grid.Column="2" Content="_Sortear de novo" Click="Reseed_Click" Margin="6,8,0,0"
                    ToolTip="Outra distribuição natural com as mesmas proporções." />
        </Grid>

        <!-- Espécies da receita -->
        <GroupBox Grid.Row="2" Header="Espécies do canteiro" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="ItemsGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ItemsGrid_SelectionChanged" AutomationProperties.Name="Espécies do canteiro">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="13" Height="13" Fill="{Binding Swatch}" Stroke="#55000000" StrokeThickness="0.6" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Papel" Binding="{Binding RoleText}" Width="78" />
                        <DataGridTextColumn Header="Espécie" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Proporção" Binding="{Binding AmountText}" Width="80" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Espaç." Binding="{Binding SpacingText}" Width="58" ElementStyle="{StaticResource VirRightCell}" />
                        <DataGridTextColumn Header="Plantas" Binding="{Binding CountText}" Width="62" ElementStyle="{StaticResource VirRightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Pa_pel" Target="{Binding ElementName=RoleBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="RoleBox" Grid.Column="1" SelectionChanged="RoleBox_SelectionChanged" AutomationProperties.Name="Papel da espécie" />
                    <TextBlock x:Name="AmountLabel" Grid.Column="2" Style="{StaticResource VirLabel}" Text="% da área" Margin="12,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="AmountBox" Grid.Column="3" LostFocus="AmountBox_LostFocus" KeyDown="Field_KeyDown" AutomationProperties.Name="Proporção ou quantidade" />
                    <TextBlock Grid.Column="4" Style="{StaticResource VirLabel}" Text="Espaçamento (m)" Margin="12,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SpacingBox" Grid.Column="5" LostFocus="SpacingBox_LostFocus" KeyDown="Field_KeyDown" AutomationProperties.Name="Espaçamento"
                             ToolTip="Vazio = o espaçamento recomendado na ficha da espécie." />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="A_dicionar espécie..." Click="Add_Click" Margin="0" />
                    <Button x:Name="RemoveButton" Content="_Remover" Click="Remove_Click" />
                    <Button x:Name="UpButton" Content="▲" Click="Up_Click" ToolTip="Sobe na ordem (dentro do mesmo papel, a primeira fica mais ao fundo)." AutomationProperties.Name="Subir" />
                    <Button x:Name="DownButton" Content="▼" Click="Down_Click" ToolTip="Desce na ordem." AutomationProperties.Name="Descer" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Prévia -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Margin="0,6,0,0">
            <c:BedPreview x:Name="Preview" />
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource VirValue}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WarningText" Style="{StaticResource VirHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="OkButton" Content="_Plantar" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}"
                        ToolTip="Coloca todos os exemplares de uma vez (e a forração de base como maciço). Um único Desfazer volta tudo." />
                <Button Content="Cancelar" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:ViridianWindow>
