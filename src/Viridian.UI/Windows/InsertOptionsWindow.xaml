<ui:ViridianWindow x:Class="Viridian.UI.Windows.InsertOptionsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Inserir exemplares"
                   Width="560" SizeToContent="Height" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Style="{StaticResource VirHeader}" Text="Inserir exemplares" TextWrapping="Wrap" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Height="170" VerticalAlignment="Top">
                <c:SymbolPreview x:Name="SymbolView" />
            </Border>
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource VirLabel}" Text="Variante gráfica" />
                <ComboBox x:Name="VariantBox" Grid.Column="1" SelectionChanged="VariantBox_SelectionChanged" />
                <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Situação" />
                <ComboBox x:Name="StatusBox" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Estágio de implantação" />
                <TextBox x:Name="StageBox" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Observações" />
                <TextBox x:Name="NotesBox" Grid.Row="3" Grid.Column="1" />
                <TextBlock x:Name="HintText" Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource VirHint}" Margin="0,10,0,0"
                           Text="Depois de confirmar, clique na vista para posicionar os exemplares. Pressione ESC para concluir." />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Inserir" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:ViridianWindow>
