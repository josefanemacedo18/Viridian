<ui:ViridianWindow x:Class="Viridian.UI.Windows.PriceSearchWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   Title="Viridian — Tabela de preços"
                   Width="860" Height="560" MinWidth="640" MinHeight="400">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Style="{StaticResource VirHeader}" TextWrapping="Wrap" />
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="_Pesquisar" Target="{Binding ElementName=SearchBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Search_Changed" AutomationProperties.Name="Pesquisar na tabela de preços"
                     ToolTip="Palavras da descrição ou parte do código, por exemplo: muda árvore, grama esmeralda, plantio" />
        </Grid>
        <DataGrid x:Name="ItemsGrid" Grid.Row="2" MouseDoubleClick="ItemsGrid_DoubleClick" SelectionChanged="ItemsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100" />
                <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Unid." Binding="{Binding Unit}" Width="60" />
                <DataGridTextColumn Header="Preço" Binding="{Binding Price, StringFormat=C2}" Width="100" ElementStyle="{StaticResource VirRightCell}" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" Style="{StaticResource VirHint}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="_Vincular" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
                <Button Content="Cancelar" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:ViridianWindow>
