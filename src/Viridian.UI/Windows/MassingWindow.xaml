<ui:ViridianWindow x:Class="Viridian.UI.Windows.MassingWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Maciço vegetal"
                   Width="940" Height="700" MinWidth="860" MinHeight="620">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Grid.ColumnSpan="2" Style="{StaticResource VirHeader}" Text="Maciço vegetal" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <GroupBox Header="Identificação">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Código do maciço" />
                        <TextBox x:Name="IdBox" Grid.Column="1" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Observações" />
                        <TextBox x:Name="NotesBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Representação">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource VirLabel}" Text="Modo" />
                            <ComboBox x:Name="ModeBox" Grid.Column="1" SelectionChanged="Input_Changed" />
                            <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Hachura" />
                            <ComboBox x:Name="HatchBox" Grid.Row="1" Grid.Column="1" SelectionChanged="Input_Changed" />
                            <TextBlock x:Name="SymbolKindLabel" Grid.Row="2" Style="{StaticResource VirLabel}" Text="Tipo de símbolo" />
                            <ComboBox x:Name="SymbolKindBox" Grid.Row="2" Grid.Column="1" SelectionChanged="Input_Changed" />
                        </Grid>
                        <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Height="64" Margin="0,6,0,0">
                            <c:HatchPreview x:Name="HatchView" />
                        </Border>
                        <TextBlock x:Name="ModeHint" Style="{StaticResource VirHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="PlantingGroup" Header="Plantio">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Distribuição" />
                        <ComboBox x:Name="PatternBox" Grid.Column="1" SelectionChanged="Pattern_Changed" />
                        <TextBlock Grid.Row="1" Style="{StaticResource VirLabel}" Text="Densidade (un/m²)" />
                        <TextBox x:Name="DensityBox" Grid.Row="1" Grid.Column="1" TextChanged="Density_Changed" />
                        <TextBlock Grid.Row="2" Style="{StaticResource VirLabel}" Text="Espaçamento (m)" />
                        <TextBox x:Name="SpacingBox" Grid.Row="2" Grid.Column="1" TextChanged="Spacing_Changed" />
                        <TextBlock Grid.Row="3" Style="{StaticResource VirLabel}" Text="Afastamento das bordas (m)" />
                        <TextBox x:Name="MarginBox" Grid.Row="3" Grid.Column="1" TextChanged="Input_Changed" />
                        <TextBlock Grid.Row="4" Style="{StaticResource VirLabel}" Text="Variação de posição (%)" />
                        <TextBox x:Name="JitterBox" Grid.Row="4" Grid.Column="1" TextChanged="Input_Changed" />
                        <TextBlock Grid.Row="5" Style="{StaticResource VirLabel}" Text="Ângulo da malha (°)" />
                        <TextBox x:Name="AngleBox" Grid.Row="5" Grid.Column="1" TextChanged="Input_Changed" />
                        <TextBlock Grid.Row="6" Style="{StaticResource VirLabel}" Text="Máximo de símbolos" />
                        <TextBox x:Name="MaxBox" Grid.Row="6" Grid.Column="1" TextChanged="Input_Changed" />
                    </Grid>
                </GroupBox>
                <CheckBox x:Name="RotationBox" Content="Girar cada símbolo aleatoriamente" />
                <Button x:Name="ReseedButton" Content="Nova distribuição" Click="Reseed_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />

                <GroupBox Header="Aquisição" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource VirLabel}" Text="Reserva de reposição (%)" />
                        <TextBox x:Name="ReserveBox" Grid.Column="1" TextChanged="Input_Changed" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1">
                <c:PlanPreview x:Name="Preview" />
            </Border>
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock x:Name="SummaryText" Style="{StaticResource VirValue}" />
                <TextBlock x:Name="PurchaseText" Style="{StaticResource VirHint}" />
                <TextBlock x:Name="MessageText" Foreground="{StaticResource VirWarning}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Criar maciço" Click="Ok_Click" IsDefault="True" Style="{StaticResource VirPrimaryButton}" />
            <Button Content="Cancelar" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:ViridianWindow>
