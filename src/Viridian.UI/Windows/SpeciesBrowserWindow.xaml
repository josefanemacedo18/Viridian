<ui:ViridianWindow x:Class="Viridian.UI.Windows.SpeciesBrowserWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Biblioteca botânica"
                   Width="1140" Height="700" MinWidth="940" MinHeight="560">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.ColumnSpan="3" Style="{StaticResource VirHeader}" Text="Biblioteca botânica" />

        <!-- Filtros projetuais -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <Label Content="_Pesquisar" Target="{Binding ElementName=SearchBox}" Style="{StaticResource VirSectionLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Código, nome popular, nome científico, família ou bioma" AutomationProperties.Name="Pesquisar" />

                <Label Content="_Categoria" Target="{Binding ElementName=CategoryBox}" Style="{StaticResource VirSectionLabel}" />
                <ComboBox x:Name="CategoryBox" SelectionChanged="Filter_Changed" AutomationProperties.Name="Categoria" />

                <TextBlock Style="{StaticResource VirSection}" Text="Origem" />
                <ComboBox x:Name="OriginBox" SelectionChanged="Filter_Changed" />

                <TextBlock Style="{StaticResource VirSection}" Text="Forma da copa" />
                <ComboBox x:Name="FormBox" SelectionChanged="Filter_Changed" />

                <TextBlock Style="{StaticResource VirSection}" Text="Altura adulta (m)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MinHeightBox" TextChanged="Filter_Changed" ToolTip="Mínima" />
                    <TextBlock Grid.Column="1" Text="a" Margin="6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="MaxHeightBox" Grid.Column="2" TextChanged="Filter_Changed" ToolTip="Máxima" />
                </Grid>

                <TextBlock Style="{StaticResource VirSection}" Text="Copa adulta (m)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MinCrownBox" TextChanged="Filter_Changed" ToolTip="Mínima" />
                    <TextBlock Grid.Column="1" Text="a" Margin="6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="MaxCrownBox" Grid.Column="2" TextChanged="Filter_Changed" ToolTip="Máxima" />
                </Grid>

                <TextBlock Style="{StaticResource VirSection}" Text="Necessidade de água" />
                <ComboBox x:Name="WaterBox" SelectionChanged="Filter_Changed" />

                <TextBlock Style="{StaticResource VirSection}" Text="Luminosidade" />
                <ComboBox x:Name="LightBox" SelectionChanged="Filter_Changed" />

                <TextBlock Style="{StaticResource VirSection}" Text="Crescimento" />
                <ComboBox x:Name="GrowthBox" SelectionChanged="Filter_Changed" />

                <TextBlock Style="{StaticResource VirSection}" Text="Bioma (nativas)" />
                <ComboBox x:Name="BiomeBox" SelectionChanged="Filter_Changed" AutomationProperties.Name="Bioma" />

                <TextBlock Style="{StaticResource VirSection}" Text="Floração no mês" />
                <ComboBox x:Name="MonthBox" SelectionChanged="Filter_Changed" AutomationProperties.Name="Floração no mês" />
                <CheckBox x:Name="ShowyBox" Content="Somente com floração vistosa" Margin="0,6,0,0"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />

                <CheckBox x:Name="UserOnlyBox" Content="Somente cadastros do escritório" Margin="0,10,0,0"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <Button Content="Limpar filtros" Click="ClearFilters_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>

        <!-- Lista -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="SpeciesGrid" SelectionChanged="SpeciesGrid_SelectionChanged" MouseDoubleClick="SpeciesGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="14" Height="14" ToolTip="{Binding ColorTip}">
                                    <Ellipse Fill="{Binding FoliageBrush}" Stroke="#55000000" StrokeThickness="0.6" />
                                    <Ellipse Width="6" Height="6" Fill="{Binding FlowerBrush}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="70" />
                    <DataGridTextColumn Header="Nome popular" Binding="{Binding PopularName}" Width="*" />
                    <DataGridTextColumn Header="Nome científico" Binding="{Binding ScientificName}" Width="*" FontStyle="Italic" />
                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoryName}" Width="84" />
                    <DataGridTextColumn Header="Origem" Binding="{Binding OriginName}" Width="92" />
                    <DataGridTextColumn Header="Altura" Binding="{Binding HeightText}" Width="60" ElementStyle="{StaticResource VirRightCell}" />
                    <DataGridTextColumn Header="Copa" Binding="{Binding CrownText}" Width="60" ElementStyle="{StaticResource VirRightCell}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="CountText" Grid.Row="1" Style="{StaticResource VirHint}" Margin="0,6,0,0" />
        </Grid>

        <!-- Ficha da espécie -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource VirCard}" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource VirGreenDark}" />
                    <TextBlock x:Name="DetailSubtitle" FontStyle="Italic" TextWrapping="Wrap" Foreground="{StaticResource VirMuted}" Margin="0,0,0,8" />
                    <Grid Height="150">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Margin="0,0,4,0">
                            <c:SymbolPreview x:Name="SymbolView" />
                        </Border>
                        <Border x:Name="PhotoBorder" Grid.Column="1" BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Margin="4,0,0,0" Background="#FAFAFA"
                                AllowDrop="True" Drop="Photo_Drop" DragOver="Photo_DragOver"
                                ToolTip="Arraste um arquivo de imagem para cá para trocar a foto">
                            <Grid>
                                <TextBlock x:Name="NoPhotoText" Text="Sem fotografia" Style="{StaticResource VirHint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="PhotoImage" Stretch="UniformToFill" AutomationProperties.Name="Fotografia da espécie" />
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PhotoCreditText" Style="{StaticResource VirHint}" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Right" />
                    <WrapPanel x:Name="PhotoButtons" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <Button Content="Trocar _foto..." Click="PhotoChange_Click" Margin="0" Padding="8,2"
                                ToolTip="Escolha um arquivo de imagem (JPG, PNG...). A foto fica na pasta de fotos da biblioteca do escritório." />
                        <Button Content="Colar imagem" Click="PhotoPaste_Click" Padding="8,2"
                                ToolTip="Cole a imagem copiada (no navegador: botão direito na foto > Copiar imagem)" />
                        <Button x:Name="PhotoRestoreButton" Content="Foto do catálogo" Click="PhotoRestore_Click" Padding="8,2"
                                ToolTip="Volta à fotografia original do catálogo padrão do Viridian" />
                    </WrapPanel>
                    <ComboBox x:Name="ProfileBox" Margin="0,6,0,0" SelectionChanged="ProfileBox_SelectionChanged" ToolTip="Perfil de representação da pré-visualização" />
                    <ItemsControl x:Name="DetailRows" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="#5F6B63" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Ações -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ManagePanel" Orientation="Horizontal">
                <Button Content="Nova espécie" Click="New_Click" Margin="0" />
                <Button x:Name="EditButton" Content="Editar" Click="Edit_Click" />
                <Button x:Name="DuplicateButton" Content="Duplicar" Click="Duplicate_Click" />
                <Button x:Name="DeleteButton" Content="Excluir" Click="Delete_Click" />
                <Button x:Name="SheetButton" Content="_Planilha ▾" Click="SheetButton_Click" Margin="16,0,0,0"
                        ToolTip="Exporta o catálogo para o Excel ou importa uma planilha editada, para revisar e alterar vários dados de uma vez.">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Exportar planilha..." Click="ExportSheet_Click"
                                      ToolTip="Grava as espécies da lista (com os filtros atuais) em uma planilha do Excel." />
                            <MenuItem Header="_Importar planilha..." Click="ImportSheet_Click"
                                      ToolTip="Lê uma planilha exportada e alterada no Excel: mostra o que muda antes de gravar. Célula vazia mantém o valor atual." />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="InsertButton" Content="Inserir" Click="Insert_Click" Style="{StaticResource VirPrimaryButton}" />
                <Button x:Name="DistributeButton" Content="Distribuir" Click="Distribute_Click" />
                <Button x:Name="MassingButton" Content="Criar maciço" Click="Massing_Click" />
                <Button x:Name="SelectButton" Content="Selecionar" Click="Select_Click" Style="{StaticResource VirPrimaryButton}" Visibility="Collapsed" />
                <Button Content="Fechar" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:ViridianWindow>
