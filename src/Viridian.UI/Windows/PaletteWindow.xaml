<ui:ViridianWindow x:Class="Viridian.UI.Windows.PaletteWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Viridian.UI"
                   xmlns:c="clr-namespace:Viridian.UI.Controls"
                   Title="Viridian — Ateliê de paletas"
                   Width="1120" Height="680" MinWidth="960" MinHeight="560">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Style="{StaticResource VirHeader}" Text="Ateliê de paletas" Margin="0" />
            <TextBlock Style="{StaticResource VirHint}" Margin="0,2,0,8"
                       Text="Escolha uma paleta pronta ou monte uma harmonia de cores. As espécies aparecem em ordem de afinidade pela cor da flor e da folhagem, na época de floração desejada." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <Label Content="_Paletas prontas" Target="{Binding ElementName=PresetList}" Style="{StaticResource VirSectionLabel}" Margin="0,0,0,4" />
                <ListBox x:Name="PresetList" Height="150" SelectionChanged="Preset_Changed" AutomationProperties.Name="Paletas prontas" />

                <TextBlock Style="{StaticResource VirSection}" Text="Ou monte a sua harmonia" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Harmonia" Target="{Binding ElementName=HarmonyBox}" Padding="0" VerticalAlignment="Center" />
                    <ComboBox x:Name="HarmonyBox" Grid.Column="1" SelectionChanged="Harmony_Changed" AutomationProperties.Name="Harmonia de cores" />
                    <Label Grid.Row="1" Content="_Cor-base" Target="{Binding ElementName=HueSlider}" Padding="0" VerticalAlignment="Center" />
                    <Slider x:Name="HueSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="359" SmallChange="5" LargeChange="30"
                            ValueChanged="Hue_Changed" Margin="0,6" AutomationProperties.Name="Matiz da cor-base" />
                </Grid>
                <Border x:Name="HueStrip" Height="10" Margin="90,0,0,4" CornerRadius="2" />
                <WrapPanel x:Name="SwatchPanel" Margin="0,4,0,0" />

                <TextBlock Style="{StaticResource VirSection}" Text="Florida em" />
                <WrapPanel x:Name="MonthPanel" />
                <TextBlock Style="{StaticResource VirHint}" Text="Sem meses marcados, vale qualquer época." />

                <TextBlock Style="{StaticResource VirSection}" Text="Filtros" />
                <ComboBox x:Name="CategoryBox" SelectionChanged="Filter_Changed" AutomationProperties.Name="Categoria" />
                <CheckBox x:Name="NativeBox" Content="Somente nativas" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <CheckBox x:Name="FlowersOnlyBox" Content="Somente com floração vistosa" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="ResultGrid" SelectionChanged="Result_SelectionChanged" MouseDoubleClick="Result_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="14" Height="14" ToolTip="{Binding Row.ColorTip}">
                                    <Ellipse Fill="{Binding Row.FoliageBrush}" Stroke="#55000000" StrokeThickness="0.6" />
                                    <Ellipse Width="7" Height="7" Fill="{Binding Row.FlowerBrush}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Código" Binding="{Binding Row.Code}" Width="66" />
                    <DataGridTextColumn Header="Nome popular" Binding="{Binding Row.PopularName}" Width="*" />
                    <DataGridTextColumn Header="Nome científico" Binding="{Binding Row.ScientificName}" Width="*" FontStyle="Italic" />
                    <DataGridTextColumn Header="Afinidade" Binding="{Binding ScoreText}" Width="70" ElementStyle="{StaticResource VirRightCell}" />
                    <DataGridTextColumn Header="Por quê" Binding="{Binding Reason}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="CountText" Grid.Row="1" Style="{StaticResource VirHint}" Margin="0,6,0,0" />
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="2" Margin="12,0,0,0">
            <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource VirGreenDark}" />
            <TextBlock x:Name="DetailSubtitle" FontStyle="Italic" TextWrapping="Wrap" Foreground="{StaticResource VirMuted}" Margin="0,0,0,6" />
            <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Height="150">
                <c:SymbolPreview x:Name="SymbolView" />
            </Border>
            <Border BorderBrush="{StaticResource VirBorder}" BorderThickness="1" Height="150" Margin="0,6,0,0" Background="#FAFAFA">
                <Grid>
                    <TextBlock x:Name="NoPhotoText" Text="Sem fotografia" Style="{StaticResource VirHint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="PhotoImage" Stretch="UniformToFill" AutomationProperties.Name="Fotografia da espécie" />
                </Grid>
            </Border>
            <TextBlock x:Name="DetailInfo" Style="{StaticResource VirHint}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="InsertButton" Content="_Inserir" Click="Insert_Click" Style="{StaticResource VirPrimaryButton}" />
            <Button x:Name="DistributeButton" Content="_Distribuir" Click="Distribute_Click" />
            <Button Content="Fechar" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:ViridianWindow>
