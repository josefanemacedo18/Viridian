<ResourceDictionary x:Class="Viridian.UI.Themes.ViridianTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="VirGreenColor">#2F6B4F</Color>
    <Color x:Key="VirGreenDarkColor">#1F4D3A</Color>
    <Color x:Key="VirGreenLightColor">#E6F0EA</Color>

    <SolidColorBrush x:Key="VirGreen" Color="{StaticResource VirGreenColor}" />
    <SolidColorBrush x:Key="VirGreenDark" Color="{StaticResource VirGreenDarkColor}" />
    <SolidColorBrush x:Key="VirGreenLight" Color="{StaticResource VirGreenLightColor}" />
    <SolidColorBrush x:Key="VirSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VirBackground" Color="#F5F7F5" />
    <SolidColorBrush x:Key="VirBorder" Color="#C9D3CC" />
    <SolidColorBrush x:Key="VirText" Color="#1E2A24" />
    <SolidColorBrush x:Key="VirMuted" Color="#5F6B63" />
    <SolidColorBrush x:Key="VirWarning" Color="#9A5B00" />
    <SolidColorBrush x:Key="VirError" Color="#A1261D" />

    <Style x:Key="VirHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VirGreenDark}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="VirSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VirGreenDark}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <!-- Rótulo de seção com tecla de acesso (Alt + letra sublinhada leva ao campo). -->
    <Style x:Key="VirSectionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VirGreenDark}" />
        <Setter Property="Margin" Value="0,10,0,4" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="VirHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VirMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="VirLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VirText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="VirValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VirText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource VirBorder}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style x:Key="VirPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{StaticResource VirGreen}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource VirGreenDark}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource VirGreenDark}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="#A9B8AF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="BorderBrush" Value="{StaticResource VirBorder}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E3E9E5" />
        <Setter Property="BorderBrush" Value="{StaticResource VirBorder}" />
        <Setter Property="Background" Value="{StaticResource VirSurface}" />
        <Setter Property="RowBackground" Value="{StaticResource VirSurface}" />
        <Setter Property="AlternatingRowBackground" Value="#F7FAF8" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style x:Key="VirCenterCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource VirGreenDark}" />
    </Style>

    <Style x:Key="VirRightCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <Style x:Key="VirCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VirSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource VirBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10" />
    </Style>

</ResourceDictionary>
